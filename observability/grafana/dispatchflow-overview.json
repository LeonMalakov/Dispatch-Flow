{
  "id": null,
  "uid": "dispatchflow-overview",
  "title": "DispatchFlow — Overview",
  "description": "DispatchFlow API diagnostics. Counters show current API process lifetime values, not database totals. HTTP charts use an adaptive rate window for periodic OTLP exports.",
  "tags": [
    "dispatchflow",
    "observability"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 42,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "15s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Orders Created",
      "description": "Current cumulative count since the API process started. Resets on API restart; this is not a PostgreSQL lifetime total.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0,
          "displayName": "Since API start",
          "min": 0,
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "vertical",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "wideLayout": false
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(dispatchflow_orders_created_total{job=\"DispatchFlow.Api\"})",
          "instant": true,
          "range": false,
          "legendFormat": "Since API start"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Orders Cancelled",
      "description": "Current cumulative count since the API process started. Resets on API restart; this is not a PostgreSQL lifetime total.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "teal"
          },
          "decimals": 0,
          "displayName": "Since API start",
          "min": 0,
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "vertical",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "wideLayout": false
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(dispatchflow_orders_cancelled_total{job=\"DispatchFlow.Api\"})",
          "instant": true,
          "range": false,
          "legendFormat": "Since API start"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Idempotency Replays",
      "description": "Current cumulative count since the API process started. Resets on API restart; this is not a PostgreSQL lifetime total.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "decimals": 0,
          "displayName": "Since API start",
          "min": 0,
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "vertical",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "wideLayout": false
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(dispatchflow_orders_idempotency_replayed_total{job=\"DispatchFlow.Api\"})",
          "instant": true,
          "range": false,
          "legendFormat": "Since API start"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Capacity Rejections",
      "description": "Current cumulative count since the API process started. Resets on API restart; this is not a PostgreSQL lifetime total.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0,
          "displayName": "Since API start",
          "min": 0,
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "vertical",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "wideLayout": false
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(dispatchflow_orders_capacity_rejected_total{job=\"DispatchFlow.Api\"})",
          "instant": true,
          "range": false,
          "legendFormat": "Since API start"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP Requests/sec",
      "description": "Completed HTTP requests per second, grouped by response status. $__rate_interval follows the Prometheus datasource interval (60s in LGTM), giving at least a 4-minute rate window. Periodic OTLP export needs at least two samples; sparse traffic can leave gaps.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 13,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Requests / second",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 8,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 4,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "decimals": 2,
          "min": 0,
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{job=\"DispatchFlow.Api\"}[$__rate_interval]))",
          "legendFormat": "HTTP {{http_response_status_code}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP Latency P95",
      "description": "95th percentile across DispatchFlow HTTP requests, calculated from histogram buckets and converted from seconds to milliseconds. Uses $__rate_interval for periodic OTLP exports. No observations produce gaps, not artificial latency values.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 13,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "teal"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Milliseconds",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 8,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 4,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "decimals": 2,
          "min": 0,
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"DispatchFlow.Api\"}[$__rate_interval])))",
          "legendFormat": "P95",
          "instant": false,
          "range": true
        }
      ]
    }
  ]
}
